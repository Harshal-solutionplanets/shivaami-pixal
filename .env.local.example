# =============================================================================
# SHIVAAMI PIXEL — Environment Variables
# =============================================================================
# 1. Copy this file:   cp .env.local.example .env.local
# 2. Fill in every value below.
# 3. NEVER commit .env.local to git — it is already in .gitignore.
# =============================================================================


# -----------------------------------------------------------------------------
# SUPABASE
# Get these from: https://supabase.com/dashboard → your project → Settings → API
# -----------------------------------------------------------------------------

# Your project's REST / Auth URL (safe to expose to the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Anon/public key — used by the browser client and server components
# (safe to expose; Row Level Security enforces access control)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Service-role secret — NEVER expose to the browser.
# Used only in server-side admin operations (bypasses RLS).
# Found under: Settings → API → Project API keys → service_role
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# -----------------------------------------------------------------------------
# ADMIN ACCESS CONTROL
# Comma-separated list of email addresses that may access /admin dashboard.
# These emails must also exist as Supabase Auth users.
# Example: ADMIN_EMAILS=alice@company.com,bob@company.com
# -----------------------------------------------------------------------------
ADMIN_EMAILS=foram.doshi@solutionplanets.com


# -----------------------------------------------------------------------------
# RAZORPAY
# Get these from: https://dashboard.razorpay.com → Settings → API Keys
# Use TEST keys for development, LIVE keys for production.
# -----------------------------------------------------------------------------

# Public key — sent to the browser to open the Razorpay Checkout modal
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx

# Secret key — used server-side to create orders and verify payment signatures
RAZORPAY_KEY_SECRET=your-razorpay-secret-here

# Webhook secret — used to verify that webhook calls come from Razorpay.
# Generate / copy from: Dashboard → Settings → Webhooks → your webhook → Secret
# The webhook URL to register in Razorpay is: https://yourdomain.com/api/razorpay/webhook
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret-here


# -----------------------------------------------------------------------------
# RESEND (Transactional Email)
# Used to send order confirmation emails to customers and internal alerts to
# pixel@shivaami.com after each B2B order.
# Get your API key from: https://resend.com/api-keys
#
# NOTE: In development the sender is hardcoded to onboarding@resend.dev (Resend
# sandbox). For production, verify your own domain in Resend and update the
# `from` field in src/app/api/orders/route.ts.
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
